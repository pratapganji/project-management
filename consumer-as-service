def write_csv_output(dataframe, output_path: str) -> str:
    """
    Write the complete Spark DataFrame as CSV files.
    """
    if dataframe is None:
        raise ValueError("Spark DataFrame is required")

    if not output_path or not output_path.strip():
        raise ValueError("Output path is required")

    output_path = output_path.strip()

    # S3 writing must wait until access authorization is implemented.
    if output_path.lower().startswith(("s3://", "s3a://", "s3n://")):
        raise ValueError("S3 authorization is not implemented yet")

    dataframe.write \
        .mode("errorifexists") \
        .option("header", "true") \
        .option("emptyValue", "") \
        .csv(output_path)

    return output_path
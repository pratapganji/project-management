SELECT
    ID,
    CONSUMER_NAME,
    FID,
    DATATYPE,
    REPORT,
    PRODUCT,
    ENTITY,
    HIERARCHY_PATH,
    JSON_VALUE(SQL_PAYLOAD, '$.dataSource') AS DATA_SOURCE,
    JSON_VALUE(SQL_PAYLOAD, '$.fileName') AS FILE_NAME,
    JSON_VALUE(SQL_PAYLOAD, '$.databaseFetchSize') AS FETCH_SIZE,
    SQL_PAYLOAD
FROM A167969NURAREC.OM_NURAFLOW_CONFIG_PAYLOAD
WHERE UPPER(CONSUMER_NAME) = 'WORKSTATION'
  AND UPPER(REPORT) = 'FRY14Q'
  AND UPPER(PRODUCT) = 'LOANS'
  AND UPPER(ENTITY) = 'FACILITY_ISR';




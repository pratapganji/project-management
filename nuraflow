BEGIN

    SELECT name
    INTO v_environment
    FROM v$database;

    DBMS_OUTPUT.PUT_LINE('Environment: ' || v_environment);

    IF v_environment = 'ORF1PRD' THEN

        v_callback_url :=
            'https://olympus.api.onerecnuraflow.prod.cloudgsl.nam.nsroot.net/olympus/nuraflow/api/callback';

